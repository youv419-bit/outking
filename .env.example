PORT=3000
APP_URL=https://outking.lol
APP_NAME=Outking
CONTACT_EMAIL=you@example.com

# Dodo Payments — https://app.dodopayments.com
# Create a one-time product with Pay What You Want enabled (min $1, max $999999)
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_webhook_secret
DODO_PRODUCT_ID=pdt_your_pwyw_product
DODO_ENVIRONMENT=test_mode

# Optional: persist data on a Railway volume mounted at /data
# (store.js keeps everything in one JSON file, not SQLite)
DATABASE_PATH=./data/outking.json

# Maintenance mode — set MAINTENANCE_MODE=true to show a maintenance page
# to everyone. Visit /?bypass=YOUR_TOKEN once (matching MAINTENANCE_BYPASS_TOKEN)
# to set a 30-day bypass cookie in your own browser and keep working on the site.
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKEN=
