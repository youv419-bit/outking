# ─────────────────────────────────────────────────────────────
# ChessBid — environment variables
# Copy to .env.local for development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Public base URL of the deployment (no trailing slash).
# Used for canonical URLs, OG tags, sitemap and payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────
# Railway provides this automatically when you attach PostgreSQL.
DATABASE_URL=postgresql://user:password@localhost:5432/chessbid
# Set to "true" when the Postgres host requires TLS but uses a self-signed cert
# (Railway's internal network does NOT need this; public proxy does).
DATABASE_SSL=false

# ── Sessions ────────────────────────────────────────────────
# 32+ random bytes. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-long-random-string

# ── Dodo Payments ───────────────────────────────────────────
# API key from the Dodo Payments dashboard (test or live).
DODO_PAYMENTS_API_KEY=
# Webhook signing secret from Dashboard → Developer → Webhooks.
DODO_PAYMENTS_WEBHOOK_KEY=
# "test_mode" or "live_mode"
DODO_PAYMENTS_ENVIRONMENT=test_mode
# A single "pay what you want" product created in Dodo that ChessBid
# reuses for every bid, sending the server-computed amount per checkout.
DODO_PRODUCT_ID=

# ── Bidding economics ───────────────────────────────────────
# Next bid = ceil(current_bid * BID_MULTIPLIER) rounded up to BID_ROUNDING.
BID_MULTIPLIER=1.10
# Round the required next bid up to the nearest N cents (100 = $1.00).
# This is also the minimum raise, so keep it small for cheap positions.
BID_ROUNDING_CENTS=100
# Currency used for all checkouts.
BID_CURRENCY=USD
